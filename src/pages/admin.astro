---
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Backoffice · Baskonia Mendi Taldea</title>
  <link rel="icon" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400;1,9..144,500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --cream: #F5F1EA;
      --cream-2: #EDE7DB;
      --cream-3: #F7F1DE;
      --yellow: #F7C40C;
      --yellow-2: #E0AD00;
      --black: #171513;
      --black-2: #241F19;
      --ink: #14181C;
      --line: #D8CFBF;
      --muted: #6E6555;
      --ok: #3E8E5A;
      --full: #C0492B;
      --display: 'Anton', Impact, sans-serif;
      --serif: 'Fraunces', Georgia, serif;
      --body: 'Manrope', system-ui, sans-serif;
      --r: 14px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: var(--body);
      background: var(--cream);
      color: var(--ink);
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      padding-bottom: 4rem;
    }
    a { color: inherit; text-decoration: none; }
    button, input, select, textarea { font-family: inherit; font-size: 1rem; }
    a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
      outline: 3px solid var(--yellow);
      outline-offset: 2px;
    }
    input:invalid:user-invalid, textarea:invalid:user-invalid {
      border-color: var(--full);
      box-shadow: 0 0 0 3px rgba(192, 73, 43, 0.18);
    }

    /* Native Dialog rules per modern-web-guidance */
    dialog:modal {
      overscroll-behavior: contain;
    }
    dialog::backdrop {
      overflow: hidden;
      overscroll-behavior: contain;
      background: rgba(15, 14, 12, 0.68);
      backdrop-filter: blur(4px);
    }
    dialog[open] {
      display: block;
      margin: auto;
      border: 1px solid var(--line);
      border-radius: var(--r);
      background: var(--cream);
      color: var(--ink);
      max-width: 760px;
      width: min(94vw, 760px);
      max-height: 90vh;
      overflow-y: auto;
      padding: 1.8rem;
      box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.7);
    }

    /* Top Header */
    .adm-header {
      background: var(--black);
      color: #fff;
      padding: 1rem clamp(16px, 4vw, 48px);
      border-bottom: 3px solid var(--yellow);
      position: sticky;
      top: 0;
      z-index: 40;
    }
    .adm-header__inner {
      max-width: 1280px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .adm-brand {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .adm-brand img {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: #fff;
      padding: 4px;
      object-fit: contain;
    }
    .adm-brand h1 {
      font-family: var(--display);
      font-weight: 400;
      font-size: 1.35rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      line-height: 1.05;
    }
    .adm-brand span {
      display: block;
      font-family: var(--serif);
      font-style: italic;
      font-size: 0.8rem;
      color: var(--yellow);
    }
    .adm-header__actions {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      flex-wrap: wrap;
    }
    .conn-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.76rem;
      font-weight: 700;
      padding: 0.4rem 0.85rem;
      border-radius: 999px;
      background: rgba(62, 142, 90, 0.2);
      color: #8ce5ab;
      border: 1px solid rgba(62, 142, 90, 0.45);
    }
    .conn-pill::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #4cd97b;
    }

    .adm-wrap {
      max-width: 1280px;
      margin: 0 auto;
      padding: 1.8rem clamp(16px, 4vw, 48px);
    }

    /* Demo Explainer Banner */
    .adm-banner {
      background: var(--cream-3);
      border: 1px solid rgba(247, 196, 12, 0.6);
      border-left: 5px solid var(--yellow);
      border-radius: var(--r);
      padding: 1rem 1.25rem;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .adm-banner p {
      font-size: 0.9rem;
      color: var(--ink);
      max-width: 82ch;
    }
    .adm-banner b {
      font-weight: 800;
    }

    /* KPIs */
    .adm-kpis {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 1rem;
      margin-bottom: 1.8rem;
    }
    .adm-kpi {
      background: #fff;
      border: 1px solid var(--line);
      border-top: 4px solid var(--yellow);
      border-radius: var(--r);
      padding: 1.1rem 1.3rem;
    }
    .adm-kpi__val {
      font-family: var(--display);
      font-size: 2.2rem;
      line-height: 1;
      color: var(--ink);
    }
    .adm-kpi__lbl {
      font-size: 0.76rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted);
      margin-top: 0.35rem;
    }

    /* Tabs */
    .adm-tabs {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      border-bottom: 2px solid var(--line);
      padding-bottom: 0.8rem;
      margin-bottom: 1.6rem;
    }
    .adm-tab {
      font-family: var(--display);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      font-size: 1rem;
      padding: 0.65rem 1.25rem;
      border-radius: 999px;
      border: 2px solid var(--line);
      background: #fff;
      color: var(--ink);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      transition: background 0.2s, border-color 0.2s, color 0.2s;
    }
    .adm-tab:hover {
      border-color: var(--black);
    }
    .adm-tab.on {
      background: var(--black);
      color: #fff;
      border-color: var(--black);
    }
    .adm-tab__count {
      font-family: var(--body);
      font-size: 0.74rem;
      font-weight: 800;
      background: var(--yellow);
      color: var(--black);
      padding: 0.1rem 0.5rem;
      border-radius: 999px;
    }

    .adm-panel { display: none; }
    .adm-panel.on { display: block; }

    /* Buttons */
    .btn-adm {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      font-weight: 700;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      padding: 0.6rem 1.1rem;
      border-radius: 999px;
      cursor: pointer;
      border: 1.5px solid transparent;
      transition: transform 0.15s, background 0.2s;
      min-height: 40px;
    }
    .btn-adm--primary { background: var(--yellow); color: var(--ink); }
    .btn-adm--primary:hover { background: var(--yellow-2); }
    .btn-adm--dark { background: var(--black); color: #fff; }
    .btn-adm--dark:hover { background: var(--black-2); }
    .btn-adm--ghost { background: transparent; border-color: rgba(255,255,255,0.35); color: #fff; }
    .btn-adm--ghost:hover { border-color: var(--yellow); color: var(--yellow); }
    .btn-adm--edit { background: var(--cream-2); border-color: var(--line); color: var(--ink); }
    .btn-adm--edit:hover { border-color: var(--black); background: var(--yellow); }
    .btn-adm--del { background: rgba(192, 73, 43, 0.1); border-color: rgba(192, 73, 43, 0.3); color: var(--full); }
    .btn-adm--del:hover { background: var(--full); color: #fff; }

    /* Toolbar */
    .adm-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1.2rem;
    }
    .adm-filters {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }
    .adm-filter-btn {
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.45rem 0.95rem;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: #fff;
      cursor: pointer;
    }
    .adm-filter-btn.on {
      background: var(--yellow);
      border-color: var(--yellow-2);
      color: var(--black);
    }

    /* Activity Cards in Admin */
    .adm-act-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .adm-act-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--r);
      overflow: hidden;
      display: grid;
      grid-template-columns: 200px 1fr;
      box-shadow: 0 8px 24px -18px rgba(0, 0, 0, 0.25);
    }
    .adm-act-thumb {
      background: var(--black) center/cover no-repeat;
      position: relative;
      min-height: 150px;
    }
    .adm-cat-pill {
      position: absolute;
      top: 10px;
      left: 10px;
      background: var(--black);
      color: var(--yellow);
      font-size: 0.66rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.25rem 0.6rem;
      border-radius: 999px;
    }
    .adm-act-main {
      padding: 1.15rem 1.35rem;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .adm-act-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .adm-date-tag {
      font-size: 0.74rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted);
    }
    .adm-act-top h3 {
      font-family: var(--display);
      font-weight: 400;
      font-size: 1.45rem;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      color: var(--ink);
    }
    .adm-act-top h3 small {
      font-family: var(--body);
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--muted);
      text-transform: none;
    }
    .adm-act-btns {
      display: flex;
      gap: 0.45rem;
      flex-wrap: wrap;
    }
    .adm-act-desc {
      font-size: 0.9rem;
      color: var(--muted);
    }

    .adm-controls-row {
      display: grid;
      grid-template-columns: minmax(210px, 1fr) minmax(240px, 1.2fr) auto;
      gap: 1rem;
      align-items: center;
      padding-top: 0.75rem;
      border-top: 1px solid var(--line);
      margin-top: auto;
    }
    .adm-ctrl-box {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .adm-ctrl-label {
      font-size: 0.74rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--muted);
    }
    .adm-ctrl-label b { color: var(--ink); }
    .adm-select {
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: var(--cream);
      font-weight: 700;
      font-size: 0.86rem;
      min-height: 42px;
    }
    .adm-seat-stepper {
      display: flex;
      align-items: center;
      gap: 0.45rem;
    }
    .adm-seat-stepper button {
      background: var(--cream-2);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 0.35rem 0.65rem;
      font-size: 0.76rem;
      font-weight: 800;
      cursor: pointer;
      min-height: 36px;
    }
    .adm-seat-stepper button:hover {
      background: var(--yellow);
      border-color: var(--yellow-2);
    }
    .adm-progress {
      flex: 1;
      height: 10px;
      background: var(--cream-2);
      border-radius: 999px;
      overflow: hidden;
      min-width: 60px;
    }
    .adm-progress span {
      display: block;
      height: 100%;
      background: var(--ok);
      transition: width 0.25s;
    }
    .adm-progress span.warn { background: var(--yellow-2); }
    .adm-progress span.full { background: var(--full); }

    .adm-ctrl-checks {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .adm-chk {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      accent-color: var(--black);
    }
    .adm-chk input {
      width: 17px;
      height: 17px;
    }

    @media (max-width: 920px) {
      .adm-act-card { grid-template-columns: 1fr; }
      .adm-act-thumb { min-height: 120px; }
      .adm-controls-row { grid-template-columns: 1fr; }
    }

    /* Table for Registrations */
    .adm-table-wrap {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--r);
      overflow-x: auto;
    }
    .adm-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    .adm-table th, .adm-table td {
      padding: 0.85rem 1rem;
      text-align: left;
      border-bottom: 1px solid var(--line);
    }
    .adm-table th {
      background: var(--black);
      color: #fff;
      font-family: var(--display);
      font-weight: 400;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      font-size: 0.85rem;
    }
    .adm-badge {
      display: inline-block;
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      font-size: 0.74rem;
      font-weight: 800;
      background: var(--cream-2);
    }
    .adm-badge.ok {
      background: rgba(62, 142, 90, 0.16);
      color: var(--ok);
    }

    /* Material & Shop Grid */
    .adm-mat-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.2rem;
      margin-bottom: 2rem;
    }
    .adm-mat-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--r);
      overflow: hidden;
    }
    .adm-mat-card img {
      width: 100%;
      aspect-ratio: 16/9;
      object-fit: cover;
    }
    .adm-mat-body {
      padding: 1.1rem;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .adm-mat-body h3 {
      font-family: var(--display);
      font-weight: 400;
      text-transform: uppercase;
      font-size: 1.3rem;
    }
    .adm-mat-body h3 small {
      font-family: var(--body);
      font-size: 0.85rem;
      color: var(--muted);
      text-transform: none;
    }
    .adm-mat-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      font-size: 0.86rem;
    }
    .adm-in-sm {
      width: 84px;
      padding: 0.4rem 0.6rem;
      border: 1px solid var(--line);
      border-radius: 8px;
      text-align: center;
      font-weight: 700;
    }

    /* Forms & Fieldsets */
    .adm-card-box {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--r);
      padding: 1.5rem;
      margin-bottom: 1.5rem;
    }
    fieldset {
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 1.1rem 1.2rem;
      margin-bottom: 1.1rem;
    }
    legend {
      font-family: var(--display);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-size: 0.95rem;
      padding: 0 0.5rem;
      color: var(--ink);
    }
    .f-grid2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.9rem;
    }
    .f-grid3 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 0.9rem;
    }
    @media (max-width: 640px) {
      .f-grid2, .f-grid3 { grid-template-columns: 1fr; }
    }
    .f-group {
      margin-block-end: 0.9rem;
      display: flex;
      flex-direction: column;
      gap: 0.28rem;
    }
    .f-group label {
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: var(--ink);
    }
    .f-group input, .f-group select, .f-group textarea {
      padding: 0.65rem 0.8rem;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: #fff;
      font-size: 1rem;
      min-height: 44px;
    }

    .adm-wl-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.85rem 0;
      border-bottom: 1px solid var(--line);
      flex-wrap: wrap;
    }
    .adm-wl-meta {
      font-size: 0.8rem;
      color: var(--muted);
    }

    /* Toast */
    .adm-toast {
      position: fixed;
      bottom: 22px;
      right: 22px;
      z-index: 120;
      background: var(--black);
      color: #fff;
      border-left: 4px solid var(--yellow);
      padding: 0.85rem 1.25rem;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.88rem;
      box-shadow: 0 18px 40px -15px rgba(0,0,0,0.7);
      transform: translateY(120%);
      opacity: 0;
      transition: transform 0.25s, opacity 0.25s;
    }
    .adm-toast.show {
      transform: translateY(0);
      opacity: 1;
    }
  </style>
</head>
<body>
  <header class="adm-header">
    <div class="adm-header__inner">
      <div class="adm-brand">
        <img src="/img/logo.png" alt="BMT Logoa">
        <div>
          <span>Baskonia Mendi Taldea · 1913</span>
          <h1>Kudeaketa Panela · Backoffice</h1>
        </div>
      </div>
      <div class="adm-header__actions">
        <span class="conn-pill" id="connBadge">Modo Demo Local · Sincronización en Vivo</span>
        <a href="/" target="_blank" class="btn-adm btn-adm--primary">Ver Web Pública (/) ↗</a>
        <button type="button" id="resetDemoBtn" class="btn-adm btn-adm--ghost">Restaurar datos originales</button>
      </div>
    </div>
  </header>

  <main class="adm-wrap">
    <div class="adm-banner">
      <p>
        <b>💡 Tip para enseñar a tus amigos del club:</b> Abre <a href="/" target="_blank" style="text-decoration:underline;font-weight:800">la web pública (/) en otra ventana al lado</a>. Cualquier cambio que hagas aquí en las plazas, estado (<i>Abierta / Completo / Próximamente</i>), nuevas salidas, material o inscripciones se refleja <b>en tiempo real al instante</b> en la web sin recargar.
      </p>
    </div>

    <section class="adm-kpis" aria-label="Resumen del club">
      <div class="adm-kpi">
        <div class="adm-kpi__val" id="kpiActs">10</div>
        <div class="adm-kpi__lbl">Actividades en calendario</div>
      </div>
      <div class="adm-kpi">
        <div class="adm-kpi__val" id="kpiSeats">0</div>
        <div class="adm-kpi__lbl">Plazas disponibles (abiertas)</div>
      </div>
      <div class="adm-kpi">
        <div class="adm-kpi__val" id="kpiRegs">3</div>
        <div class="adm-kpi__lbl">Inscripciones recibidas</div>
      </div>
      <div class="adm-kpi">
        <div class="adm-kpi__val" id="kpiMat">25</div>
        <div class="adm-kpi__lbl">Unidades de material en stock</div>
      </div>
    </section>

    <div class="adm-tabs" role="tablist" aria-label="Secciones del Backoffice">
      <button type="button" class="adm-tab on" role="tab" aria-selected="true" data-tab="activities">
        1 · Jarduerak eta Plazak (Salidas y Cursos)
      </button>
      <button type="button" class="adm-tab" role="tab" aria-selected="false" data-tab="registrations">
        2 · Izen-emateak (Inscripciones) <span class="adm-tab__count" id="tabRegCount">3</span>
      </button>
      <button type="button" class="adm-tab" role="tab" aria-selected="false" data-tab="materials">
        3 · Materiala, Denda eta Bulegoa
      </button>
      <button type="button" class="adm-tab" role="tab" aria-selected="false" data-tab="wikiloc">
        4 · Wikiloc &amp; Supabase Cloud
      </button>
    </div>

    <!-- PANEL 1: ACTIVITIES -->
    <section class="adm-panel on" data-panel="activities">
      <div class="adm-toolbar">
        <div class="adm-filters">
          <button type="button" class="adm-filter-btn js-cat-filter on" data-cat="all">Todas</button>
          <button type="button" class="adm-filter-btn js-cat-filter" data-cat="irteera">Irteerak (Salidas)</button>
          <button type="button" class="adm-filter-btn js-cat-filter" data-cat="ikastaroa">Ikastaroak (Cursos)</button>
          <button type="button" class="adm-filter-btn js-cat-filter" data-cat="jardunaldia">Jardunaldiak</button>
          <button type="button" class="adm-filter-btn js-cat-filter" data-cat="ekitaldia">Ekitaldiak</button>
        </div>
        <button type="button" id="newActBtn" class="btn-adm btn-adm--primary">+ Crear Nueva Salida / Curso</button>
      </div>
      <div class="adm-act-list" id="admActList"></div>
    </section>

    <!-- PANEL 2: REGISTRATIONS -->
    <section class="adm-panel" data-panel="registrations">
      <div class="adm-toolbar">
        <div style="display:flex;align-items:center;gap:.7rem;flex-wrap:wrap">
          <label for="regActFilter" style="font-weight:800;font-size:.82rem;text-transform:uppercase">Filtrar por actividad:</label>
          <select id="regActFilter" name="activity_filter" class="adm-select"></select>
        </div>
        <div style="display:flex;gap:.6rem;flex-wrap:wrap">
          <button type="button" id="simRegBtn" class="btn-adm btn-adm--edit">+ Simular inscripción de prueba</button>
          <button type="button" id="exportCsvBtn" class="btn-adm btn-adm--primary">📥 Exportar a Excel / CSV</button>
        </div>
      </div>

      <div class="adm-table-wrap">
        <table class="adm-table">
          <thead>
            <tr>
              <th>Izen-abizenak / NAN</th>
              <th>Jarduera (Actividad)</th>
              <th>Bazkidea?</th>
              <th>Harremana (Contacto)</th>
              <th>Oharrak (Notas)</th>
              <th>Data</th>
              <th>Ekintza</th>
            </tr>
          </thead>
          <tbody id="regTableBody"></tbody>
        </table>
      </div>
    </section>

    <!-- PANEL 3: MATERIALS & SHOP -->
    <section class="adm-panel" data-panel="materials">
      <h2 style="font-family:var(--display);text-transform:uppercase;font-size:1.7rem;margin-bottom:.9rem">Neguko Materiala (Stock y Precios de Alquiler)</h2>
      <div class="adm-mat-grid" id="admMatGrid"></div>

      <div class="adm-card-box">
        <form id="shopSettingsForm" action="/admin" method="POST">
          <fieldset>
            <legend>Horario de Oficina (Banner Principal) y Tienda Oficial (BMT Kamiseta)</legend>
            <div class="f-grid2">
              <div class="f-group">
                <label for="set-office-eu">Horario de oficina (Euskera)</label>
                <input id="set-office-eu" name="office_hours_eu" type="text" required>
              </div>
              <div class="f-group">
                <label for="set-office-es">Horario de oficina (Castellano)</label>
                <input id="set-office-es" name="office_hours_es" type="text" required>
              </div>
            </div>
            <div class="f-grid3">
              <div class="f-group">
                <label for="set-shirt-price">Precio Camiseta BMT (€)</label>
                <input id="set-shirt-price" name="shirt_price_eur" type="number" min="1" required>
              </div>
              <div class="f-group">
                <label for="set-shirt-sizes">Tallas disponibles (separadas por coma)</label>
                <input id="set-shirt-sizes" name="shirt_sizes" type="text" required>
              </div>
              <div class="f-group">
                <label for="set-shirt-where-eu">Disponibilidad (EUS / CAST)</label>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:.4rem">
                  <input id="set-shirt-where-eu" name="shirt_where_eu" type="text" required>
                  <input id="set-shirt-where-es" name="shirt_where_es" type="text" required>
                </div>
              </div>
            </div>
            <button type="submit" class="btn-adm btn-adm--primary">Guardar horario y tienda</button>
          </fieldset>
        </form>
      </div>
    </section>

    <!-- PANEL 4: WIKILOC & SUPABASE -->
    <section class="adm-panel" data-panel="wikiloc">
      <div class="f-grid2">
        <div class="adm-card-box">
          <form id="newWikiForm" action="/admin" method="POST">
            <fieldset>
              <legend>Añadir Ruta al Carrusel de Wikiloc</legend>
              <div class="f-grid2">
                <div class="f-group">
                  <label for="wl-title-eu">Nombre de la ruta (Euskera) *</label>
                  <input id="wl-title-eu" name="title_eu" type="text" required>
                </div>
                <div class="f-group">
                  <label for="wl-title-es">Nombre de la ruta (Castellano)</label>
                  <input id="wl-title-es" name="title_es" type="text">
                </div>
              </div>
              <div class="f-grid2">
                <div class="f-group">
                  <label for="wl-diff">Dificultad</label>
                  <select id="wl-diff" name="difficulty">
                    <option value="erraza">Erraza / Fácil</option>
                    <option value="ertaina" selected>Ertaina / Media</option>
                    <option value="zaila">Zaila / Difícil</option>
                  </select>
                </div>
                <div class="f-group">
                  <label for="wl-km">Distancia (km)</label>
                  <input id="wl-km" name="km" type="text">
                </div>
              </div>
              <div class="f-grid2">
                <div class="f-group">
                  <label for="wl-up">Desnivel positivo (+m)</label>
                  <input id="wl-up" name="up_m" type="text">
                </div>
                <div class="f-group">
                  <label for="wl-down">Desnivel negativo (-m)</label>
                  <input id="wl-down" name="down_m" type="text">
                </div>
              </div>
              <div class="f-group">
                <label for="wl-url">Enlace de Wikiloc (URL) *</label>
                <input id="wl-url" name="url" type="url" required autocorrect="off" autocapitalize="off" spellcheck="false">
              </div>
              <button type="submit" class="btn-adm btn-adm--primary">+ Publicar ruta de Wikiloc</button>
            </fieldset>
          </form>

          <h3 style="font-family:var(--display);text-transform:uppercase;margin:1rem 0 .5rem">Rutas publicadas actualmente</h3>
          <div id="admWikiList"></div>
        </div>

        <div class="adm-card-box">
          <form id="supaConfigForm" action="/admin" method="POST">
            <fieldset>
              <legend>Conexión en la Nube con Supabase (Opcional)</legend>
              <p style="font-size:.88rem;color:var(--muted);margin-bottom:1rem">
                Por defecto el prototipo funciona en local sincronizando pestañas en vivo. Cuando creéis el proyecto gratuito en <b>supabase.com</b> y ejecutéis el archivo <code>supabase/schema.sql</code> incluido en este repositorio, podéis pegar aquí las credenciales (o en el archivo <code>.env</code>):
              </p>
              <div class="f-group">
                <label for="supa-url">SUPABASE_URL</label>
                <input id="supa-url" name="supabase_url" type="url" autocorrect="off" autocapitalize="off" spellcheck="false">
              </div>
              <div class="f-group">
                <label for="supa-key">SUPABASE_ANON_KEY</label>
                <input id="supa-key" name="supabase_anon_key" type="text" autocorrect="off" autocapitalize="off" spellcheck="false">
              </div>
              <button type="submit" class="btn-adm btn-adm--dark">Guardar configuración de Supabase</button>
            </fieldset>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- NATIVE MODAL DIALOG FOR EDITING / CREATING ACTIVITY -->
  <dialog id="actEditorDialog" closedby="any" aria-labelledby="actEditorTitle">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;border-bottom:1px solid var(--line);padding-bottom:.8rem">
      <h2 id="actEditorTitle" style="font-family:var(--display);text-transform:uppercase;font-size:1.75rem">Editar actividad</h2>
      <button type="button" id="closeActDialogBtn" class="btn-adm btn-adm--edit" aria-label="Cerrar ventana">Cerrar &times;</button>
    </div>

    <form id="actEditorForm" action="/admin" method="POST">
      <fieldset>
        <legend>1 · Tipo, Estado y Títulos Bilingües (EUS / CAST)</legend>
        <div class="f-grid2">
          <div class="f-group">
            <label for="ed-category">Categoría</label>
            <select id="ed-category" name="category">
              <option value="irteera">Irteera (Salida de montaña)</option>
              <option value="ikastaroa">Ikastaroa (Curso de formación)</option>
              <option value="jardunaldia">Jardunaldia (Jornadas / Charlas)</option>
              <option value="ekitaldia">Ekitaldia (Evento social)</option>
            </select>
          </div>
          <div class="f-group">
            <label for="ed-status">Estado de inscripción</label>
            <select id="ed-status" name="status">
              <option value="open">🟢 Abierta (Muestra plazas disponibles)</option>
              <option value="full">🔴 Betea / Completo (Sin plazas)</option>
              <option value="soon">🕒 Laster / Próximamente</option>
              <option value="closed">⚪ Itxita / Cerrada</option>
            </select>
          </div>
        </div>

        <div class="f-grid2">
          <div class="f-group">
            <label for="ed-title-eu">Título en Euskera *</label>
            <input id="ed-title-eu" name="title_eu" type="text" required autofocus>
          </div>
          <div class="f-group">
            <label for="ed-title-es">Título en Castellano *</label>
            <input id="ed-title-es" name="title_es" type="text" required>
          </div>
        </div>

        <div class="f-grid2">
          <div class="f-group">
            <label for="ed-summary-eu">Resumen corto (Euskera)</label>
            <textarea id="ed-summary-eu" name="summary_eu" rows="2"></textarea>
          </div>
          <div class="f-group">
            <label for="ed-summary-es">Resumen corto (Castellano)</label>
            <textarea id="ed-summary-es" name="summary_es" rows="2"></textarea>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend>2 · Fechas, Plazas y Fotografía</legend>
        <div class="f-grid2">
          <div class="f-group">
            <label for="ed-date-eu">Etiqueta de fecha (Euskera · ej. Urria 3–4)</label>
            <input id="ed-date-eu" name="date_badge_eu" type="text" required>
          </div>
          <div class="f-group">
            <label for="ed-date-es">Etiqueta de fecha (Castellano · ej. 3–4 de octubre)</label>
            <input id="ed-date-es" name="date_badge_es" type="text" required>
          </div>
        </div>

        <div class="f-grid3">
          <div class="f-group">
            <label for="ed-cal-day">Día en Calendario (ej. 12–13)</label>
            <input id="ed-cal-day" name="cal_day" type="text">
          </div>
          <div class="f-group">
            <label for="ed-cal-month-eu">Mes (Euskera · ej. Iraila)</label>
            <input id="ed-cal-month-eu" name="cal_month_eu" type="text">
          </div>
          <div class="f-group">
            <label for="ed-cal-month-es">Mes (Castellano · ej. Septiembre)</label>
            <input id="ed-cal-month-es" name="cal_month_es" type="text">
          </div>
        </div>

        <div class="f-grid3">
          <div class="f-group">
            <label for="ed-capacity">Plazas Totales</label>
            <input id="ed-capacity" name="capacity" type="number" min="0">
          </div>
          <div class="f-group">
            <label for="ed-occupied">Plazas Ocupadas</label>
            <input id="ed-occupied" name="occupied" type="number" min="0">
          </div>
          <div class="f-group">
            <label for="ed-days">Duración (días)</label>
            <input id="ed-days" name="days" type="number" min="1">
          </div>
        </div>

        <div class="f-grid2">
          <div class="f-group">
            <label for="ed-level-eu">Nivel / Dificultad (Euskera)</label>
            <input id="ed-level-eu" name="level_eu" type="text">
          </div>
          <div class="f-group">
            <label for="ed-level-es">Nivel / Dificultad (Castellano)</label>
            <input id="ed-level-es" name="level_es" type="text">
          </div>
        </div>

        <div class="f-group">
          <label for="ed-image">URL de imagen de fondo (o ruta /img/...)</label>
          <input id="ed-image" name="image" type="text" autocorrect="off" autocapitalize="off" spellcheck="false">
        </div>
      </fieldset>

      <fieldset>
        <legend>3 · Ficha Detallada (Modal al hacer clic en la actividad)</legend>
        <div class="f-grid2">
          <div class="f-group">
            <label for="ed-non">Lugar / Destino (Non)</label>
            <input id="ed-non" name="non" type="text">
          </div>
          <div class="f-group">
            <label for="ed-ordutegia">Horario (Ordutegia)</label>
            <input id="ed-ordutegia" name="ordutegia" type="text">
          </div>
        </div>
        <div class="f-grid2">
          <div class="f-group">
            <label for="ed-geltokiak">Paradas y horas de autobús (1 por línea)</label>
            <textarea id="ed-geltokiak" name="geltokiak" rows="3"></textarea>
          </div>
          <div class="f-group">
            <label for="ed-prezioa">Precios (1 por línea)</label>
            <textarea id="ed-prezioa" name="prezioa" rows="3"></textarea>
          </div>
        </div>
        <div style="display:flex;gap:1.2rem;flex-wrap:wrap;margin-top:.4rem">
          <label class="adm-chk"><input id="ed-cards" name="visible_in_cards" type="checkbox"><span>Mostrar tarjeta visual en la web</span></label>
          <label class="adm-chk"><input id="ed-cal" name="visible_in_calendar" type="checkbox"><span>Mostrar fila en el Calendario</span></label>
          <label class="adm-chk"><input id="ed-reg" name="registration_enabled" type="checkbox"><span>Activar formulario de inscripción online</span></label>
        </div>
      </fieldset>

      <div style="display:flex;justify-content:flex-end;gap:.75rem;margin-top:1rem">
        <button type="submit" class="btn-adm btn-adm--primary">Guardar y publicar cambios en vivo</button>
      </div>
    </form>
  </dialog>

  <div class="adm-toast" id="adminToast" role="status" aria-live="polite"></div>

  <script>
    import { initAdminClient } from '../scripts/adminClient';
    initAdminClient();
  </script>
</body>
</html>
