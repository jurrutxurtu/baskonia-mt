---
import '../styles/bmt.css';
import Modals from '../components/Modals.astro';
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---
<!DOCTYPE html>
<html lang="eu" style={`--logo:url('${base}img/logo.png');--hero-bg:url('${base}img/hero-bg.jpg')`}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <link rel="manifest" href={`${base}manifest.json`}>
  <meta name="theme-color" content="#171513">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="BMT">
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}>
  <link rel="icon" type="image/png" sizes="192x192" href={`${base}icon-192.png`}>
  <title>Baskonia Mendi Taldea · 1913tik mendian</title>
  <meta name="description" content="Baskonia Mendi Taldea — Basauriko mendizale elkartea, 1913tik. Ikastaroak, irteerak, jardunaldiak, aterpea, material alokairua eta federazioa.">
  <link rel="icon" href={`${base}img/favicon.png`}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400;1,9..144,500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
<header id="header">
  <nav class="nav">
    <div class="menu menu--l">
      <a href="#hasiera">Hasiera</a>
      <a href="#nor-gara">Nortzuk gara</a>
      <a href="#ikastaroak">Ikastaroak</a>
      <a href="#irteerak">Irteerak</a>
      <a href="#jardunaldiak">Jardunaldiak</a>
      <a href="#wikiloc">Wikiloc</a>
      <a href="#egutegia">Egutegia</a>
    </div>
    <a href="#hasiera" class="brand brand--logo-only" aria-label="BMT hasiera">
      <span class="brand__logo" role="img" aria-label="BMT logoa"></span>
    </a>
    <div class="menu menu--r">
      <a href="#aterpea">Aterpea</a>
      <a href="#materiala">Materiala</a>
      <a href="#arropa">Denda</a>
      <a href="#galeria">Galeria</a>
      <a href="#federazioa">Federazioa</a>
      <a href="#bus-geltokiak">Bus geltokiak</a>
      <a href="#harremana">Harremana</a>
      <div class="langsw langsw--d" role="group" aria-label="Hizkuntza / Idioma"><button type="button" data-lang="eu" aria-pressed="true">EUS</button><button type="button" data-lang="es" aria-pressed="false">CAST</button></div>
    </div>
    <div class="langsw langsw--m" role="group" aria-label="Hizkuntza / Idioma"><button type="button" data-lang="eu" aria-pressed="true">EUS</button><button type="button" data-lang="es" aria-pressed="false">CAST</button></div>
    <button class="burger" id="burger" aria-label="Menua ireki"><span></span><span></span><span></span></button>
  </nav>
</header>
<div class="drawer" id="drawer">
  <button class="drawer__close" id="drawerClose" aria-label="Itxi">&times;</button>
  <div class="langsw langsw--drawer" role="group" aria-label="Hizkuntza / Idioma"><button type="button" data-lang="eu" aria-pressed="true">EUS</button><button type="button" data-lang="es" aria-pressed="false">CAST</button></div>
  <a href="#hasiera">Hasiera</a><a href="#nor-gara">Nortzuk gara</a><a href="#ikastaroak">Ikastaroak</a><a href="#irteerak">Irteerak</a><a href="#jardunaldiak">Jardunaldiak</a>
  <a href="#wikiloc">Wikiloc</a><a href="#egutegia">Egutegia</a><a href="#aterpea">Aterpea</a>
  <a href="#materiala">Materiala</a><a href="#arropa">Denda</a><a href="#galeria">Galeria</a>
  <a href="#federazioa">Federazioa</a><a href="#bus-geltokiak">Bus geltokiak</a><a href="#app">Aplikazioa</a><a href="#harremana">Harremana</a>
</div>

<section class="hero" id="hasiera">
  <div class="hero__bg"></div>
  <svg class="topo" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true" style="opacity:.16;z-index:2">
    <path d="M-50,420 C200,360 420,470 650,410 C880,350 1050,440 1260,390" stroke="#fff"/>
    <path d="M-50,470 C200,415 420,520 650,460 C880,400 1050,490 1260,440" stroke="#fff"/>
    <path d="M-50,520 C200,470 420,565 650,510 C880,455 1050,540 1260,495" stroke="#fff"/>
  </svg>
  <div class="hero__inner reveal">
    <span class="kicker">1913tik mendian</span>
    <h1>Baskonia Mendi Taldea</h1>
    <p class="hero__sub">Basauriko mendizale elkartea. Mendia, kirola eta natura, denon eskura.</p>
    <div class="hero__office"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span id="heroOfficeText" data-i18n-skip="true"><b>Bulegoa</b> asteazkenetan zabalik · 19:00 – 21:00</span></div>
    <div class="hero__cta"><button class="btn btn--primary" id="historyBtn" aria-haspopup="dialog">Gure historia</button><button class="btn btn--ghost-y" id="armarriaBtn" aria-haspopup="dialog">Armarriaren historia</button></div>
  </div>
  <div class="hero__scroll">Behera ↓</div>
</section>

<section class="band band--cream" id="nor-gara">
  <div class="band__inner">
    <div class="twocol">
      <div class="reveal"><span class="kicker">Nortzuk gara</span><h2>Mende bat baino<br>gehiago mendian</h2>
        <figure class="norgara-logo"><div class="norgara-logo__plate" role="img" aria-label="Baskonia Mendi Taldearen armarri ofiziala"></div><figcaption>Baskonia Mendi Taldea · 1913</figcaption></figure>
      </div>
      <div class="reveal">
        <p>Baskonia Mendi Taldea 1913an sortu zen Basaurin, Bizkaiko mendi-elkarte historikoenetako bat. Mende bat baino gehiagoko ibilbidean, mendiarekiko zaletasuna belaunaldiz belaunaldi zabaltzen jardun dugu: irteerak, ikastaroak, jardunaldiak eta Iondokorta aterpea, denon ondare.</p>
        <p style="margin-top:1rem">Etorri, ezagutu gaitzazu eta egin bidea gurekin.</p>
        <div class="stats stats--2 stats--inline">
          <div class="stat"><div class="stat__num" data-target="1913">1913</div><div class="stat__label">Sortze-urtea</div></div>
          <div class="stat"><div class="stat__num" data-target="1000" data-suffix="+">0</div><div class="stat__label">Bazkideak</div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="band band--cream-2" id="ikastaroak">
  <div class="band__inner">
    <div class="head reveal">
      <span class="kicker">Ikastaroak</span><h2>Datozen<br>ikastaroak</h2>
      <p>Hurrengo ikastaroak eta izena emateko zabalik daudenak. Tokiak mugatuak dira; izena aldez aurretik eman behar da.</p>
    </div>
    <div class="grid-cards" id="ikastaroakGrid">
      <article class="card reveal">
        <div class="card__img" style="background-image:url('https://images.unsplash.com/photo-1522163182402-834f871fd851?w=700&q=80&auto=format&fit=crop')"></div>
        <div class="card__body">
          <h3>Eskaladako hastapena</h3>
          <p>Eskalada-teknika oinarrizkoak, segurtasuna eta lehen igoerak gidari batekin.</p>
          <div class="card__foot">
            <span class="lekuak" data-act="ik-eskalada-hastapena-2026" data-cap="20">20 plaza</span>
          </div>
        </div>
      </article>
      <article class="card reveal">
        <div class="card__img" style="background-image:url('https://images.unsplash.com/photo-1551524559-8af4e6624178?w=700&q=80&auto=format&fit=crop')"></div>
        <div class="card__body">
          <h3>Eskaladako autoerreskatea</h3>
          <p>Larrialdietan jarduteko teknikak: maniobrak, jaitsierak eta erreskate-sistemak.</p>
          <div class="card__foot">
            <span class="lekuak" data-act="ik-autoerreskatea-2026" data-cap="16">16 plaza</span>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="band band--cream-3" id="irteerak">
  <div class="band__inner">
    <div class="head reveal"><span class="kicker">Irteerak</span><h2>Datozen<br>irteerak</h2>
      <p>Aurten geratzen diren irteerak. Talde giroan, segurtasunez eta natura zainduz. Izena emateko lekuak mugatuak dira.</p>
    </div>
    <div class="routes" id="irteerakGrid">
      <article class="route reveal" style="background-image:url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=900&q=80&auto=format&fit=crop')">
        <div class="route__top"><span class="route__tag">Iraila 12–13</span><span class="lekuak" data-act="ir-bidarrai-2026" data-cap="35">40 plaza</span></div>
        <h3>Iparraldeko ehun mendiak</h3><p>Iparla (1.044 m) eta Behorlegi (1.265 m) inguruko irteera, Ipar Euskal Herrian.</p>
      </article>
      <article class="route reveal" style="background-image:url('https://images.unsplash.com/photo-1454496522488-7a8e488e8606?w=900&q=80&auto=format&fit=crop')">
        <div class="route__top"><span class="route__tag">Iraila 20</span></div>
        <h3>Oroimenaren eguna Besaiden</h3><p>Besaideko oroimen-eguna, mendizaleak gogoratzeko urteroko hitzordua.</p>
      </article>
      <article class="route reveal" style="background-image:url('https://images.unsplash.com/photo-1470770841072-f978cf4d019e?w=900&q=80&auto=format&fit=crop')">
        <div class="route__top"><span class="route__tag">Urria 3–4</span><span class="lekuak" data-act="ir-bardenak-2026" data-cap="35">45 plaza</span></div>
        <h3>Bardeak</h3><p>Nafarroako Bardeak: Pisquerra (465 m) eta Rallón (493 m), paisaia lehor ikusgarrian.</p>
      </article>
      <article class="route reveal" style="background-image:url('https://images.unsplash.com/photo-1551632811-561732d1e306?w=900&q=80&auto=format&fit=crop')">
        <div class="route__top"><span class="route__tag">Abendua 13</span></div>
        <h3>Castrovalnera</h3><p>Castrovalnera (1.718 m), urteko azken irteera handietako bat.</p>
      </article>
    </div>
  </div>
</section>

<section class="band band--cream" id="jardunaldiak">
  <div class="band__inner">
    <div class="head reveal"><span class="kicker">Jardunaldiak</span><h2>Mendi<br>jardunaldiak</h2>
      <p>Hitzaldiak, tailerrak eta jardunaldi bereziak.</p>
    </div>
    <div class="routes" id="jardunaldiakGrid">
      <article class="route reveal" style="background-image:url('https://images.unsplash.com/photo-1486870591958-9b9d0d1dda99?w=900&q=80&auto=format&fit=crop')">
        <div class="route__top"><span class="route__tag">Azaroa 3·10·17·24</span></div>
        <h3>Mendi jardunaldiak</h3><p>Azaroko lau asteartez, mendiari buruzko hitzaldi eta jardunaldien zikloa.</p>
      </article>
    </div>
  </div>
</section>

<section class="band band--cream-2" id="wikiloc">
  <div class="band__inner">
    <div class="head reveal"><span class="kicker">Ibilbideak</span><h2>Gure<br>Wikiloc bilduma</h2>
      <p>BMTrekin egindako ibilbideak, bazkideek partekatutakoak eta etxetik gertu egin daitezkeen txangoak. Deskargatu track-a edo ikusi ibilbidea Wikilocen.</p>
    </div>
    <div class="wiki-search reveal">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input type="search" id="wikiSearch" placeholder="Bilatu ibilbidea izenaren arabera…" aria-label="Bilatu ibilbidea">
    </div>
    <p class="wiki-empty" id="wikiEmpty">Ez da bat datorren ibilbiderik aurkitu.</p>
    <div class="wiki-rail-wrap"><button class="wiki-arrow prev" id="wikiPrev" type="button" aria-label="Aurrekoa">&#8249;</button>
    <div class="wiki-rail" id="wikiGrid">
      <article class="wiki-card reveal" data-wtitle="basauri – gorbeia gauez">
        <div class="wiki-card__map"><svg class="wiki-topo" viewBox="0 0 400 88" preserveAspectRatio="none" aria-hidden="true"><path d="M-10,60 C60,40 120,66 200,48 C280,32 340,58 410,42"/><path d="M-10,72 C60,54 120,80 200,60 C280,46 340,70 410,56"/></svg><span class="wiki-diff zaila">Zaila</span></div>
        <div class="wiki-card__b"><h3>Basauri – Gorbeia gauez</h3><div class="wiki-meta"><span class="wiki-lvl zaila">Zailtasuna: <b>Zaila</b></span><span class="wiki-num"><b>41,4</b> km</span><span class="wiki-num up"><b>2.118</b> m &#8593;</span><span class="wiki-num down"><b>1.223</b> m &#8595;</span></div><a class="btn btn--ghost-dark" href="https://es.wikiloc.com/rutas-senderismo/marcha-nocturna-basauri-gorbea-10021132" target="_blank" rel="noopener">Wikiloc-en ikusi</a></div>
      </article>
      <article class="wiki-card reveal" data-wtitle="mugarriz mugarri basauri">
        <div class="wiki-card__map"><svg class="wiki-topo" viewBox="0 0 400 88" preserveAspectRatio="none" aria-hidden="true"><path d="M-10,58 C70,44 130,62 210,46 C290,34 350,56 410,44"/><path d="M-10,70 C70,56 130,74 210,58 C290,46 350,68 410,56"/></svg><span class="wiki-diff ertaina">Ertaina</span></div>
        <div class="wiki-card__b"><h3>Mugarriz mugarri Basauri</h3><div class="wiki-meta"><span class="wiki-lvl ertaina">Zailtasuna: <b>Ertaina</b></span><span class="wiki-num"><b>—</b> km</span><span class="wiki-num up"><b>—</b> m &#8593;</span><span class="wiki-num down"><b>—</b> m &#8595;</span></div><a class="btn btn--ghost-dark" href="https://es.wikiloc.com/rutas-senderismo/basauri-mugarriz-mugarri-66993395" target="_blank" rel="noopener">Wikiloc-en ikusi</a></div>
      </article>
      <article class="wiki-card reveal" data-wtitle="basauriko bira">
        <div class="wiki-card__map"><svg class="wiki-topo" viewBox="0 0 400 88" preserveAspectRatio="none" aria-hidden="true"><path d="M-10,64 C60,36 120,70 200,42 C280,24 340,60 410,38"/><path d="M-10,76 C60,48 120,82 200,54 C280,36 340,72 410,50"/></svg><span class="wiki-diff ertaina">Ertaina</span></div>
        <div class="wiki-card__b"><h3>Basauriko Bira</h3><div class="wiki-meta"><span class="wiki-lvl ertaina">Zailtasuna: <b>Ertaina</b></span><span class="wiki-num"><b>—</b> km</span><span class="wiki-num up"><b>—</b> m &#8593;</span><span class="wiki-num down"><b>—</b> m &#8595;</span></div><a class="btn btn--ghost-dark" href="https://es.wikiloc.com/rutas-senderismo/basauriko-bira-kukurrustu-oiarkrutze-malmasin-casco-titigana-san-bizente-titigane-217422520" target="_blank" rel="noopener">Wikiloc-en ikusi</a></div>
      </article>
    </div>
    <button class="wiki-arrow next" id="wikiNext" type="button" aria-label="Hurrengoa">&#8250;</button>
    </div>
  </div>
</section>

<section class="band band--dark" id="egutegia">
  <svg class="topo" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true" style="opacity:.07">
    <path d="M-50,150 C250,90 500,210 750,140 C950,85 1100,170 1260,120" stroke="#F7C40C"/>
    <path d="M-50,250 C250,190 500,310 750,240 C950,185 1100,270 1260,220" stroke="#F7C40C"/>
    <path d="M-50,350 C250,290 500,410 750,340 C950,285 1100,370 1260,320" stroke="#F7C40C"/>
  </svg>
  <div class="band__inner">
    <div class="head reveal"><span class="kicker">Egutegia eta ordutegiak</span><h2>Datozen<br>jarduerak</h2>
      <p>Aurten geratzen diren jarduerak, hurbilenetik urrunenera. Irteera bakoitzaren ordua eta jasotze-puntuak iragarki zehatzean adierazten dira beti.</p>
    </div>
    <div class="cal-list reveal" id="egutegiaList">
      <div class="cal-row" data-act="ir-bidarrai-2026"><div class="date">12–13<small>Iraila</small></div><div class="what">Iparraldeko ehun mendiak<span>Iparla – Behorlegi</span></div><div class="lvl ir">Irteera</div></div>
      <div class="cal-row" data-act="ir-besaide-2026"><div class="date">20<small>Iraila</small></div><div class="what">Oroimenaren eguna Besaiden<span>Irteera</span></div><div class="lvl ir">Irteera</div></div>
      <div class="cal-row" data-act="ir-bardenak-2026"><div class="date">3–4<small>Urria</small></div><div class="what">Bardeak / Las Bardenas<span>Irteera</span></div><div class="lvl ir">Irteera</div></div>
      <div class="cal-row" data-act="ja-mendi-jardunaldiak-2026"><div class="date">3·10·17·24<small>Azaroa</small></div><div class="what">Mendi jardunaldiak<span>Jardunaldia</span></div><div class="lvl ja">Jardunaldia</div></div>
      <div class="cal-row" data-act="ir-malmasin-2026"><div class="date">8<small>Azaroa</small></div><div class="what">Irteera historikoa Malmasin inguruan<span>Irteera</span></div><div class="lvl ir">Irteera</div></div>
      <div class="cal-row" data-act="ir-castrovalnera-2026"><div class="date">13<small>Abendua</small></div><div class="what">Castrovalnera (1.718 m)<span>Irteera</span></div><div class="lvl ir">Irteera</div></div>
      <div class="cal-row" data-act="ir-bazkaria-2026"><div class="date">20<small>Abendua</small></div><div class="what">Adiskidetasunaren bazkaria<span>Ekitaldia</span></div><div class="lvl ir">Irteera</div></div>
      <div class="cal-row" data-act="ir-agur-2026"><div class="date">31<small>Abendua</small></div><div class="what">Agur urteari Gorbeian<span>Irteera</span></div><div class="lvl ir">Irteera</div></div>
    </div>
    <button class="btn btn--ghost-y" id="egutegiaBtn" aria-haspopup="dialog">Egutegi osoa ikusi (2026)</button>
  </div>
</section>

<section class="band band--cream" id="aterpea">
  <div class="band__inner">
    <div class="aterpe-wrap">
      <div class="head head--center reveal"><span class="kicker">Aterpea</span><h2>Gure babesa<br>mendian</h2>
        <p>Gure aterpeak banaka alokatu daitezkeen bi gune ditu: <b>Aterpe handia</b> eta <b>Aterpe txikia</b>. Mendi giroan, egonaldietarako eta talde-irteeretarako leku aproposa.</p>
      </div>
      <div class="carousel refuge-car reveal" id="aterpeaCar">
        <div class="carousel__track"><div class="carousel__slide" style={`background-image:url('${base}img/aterpea/slide-01.jpg')`}></div><div class="carousel__slide" style={`background-image:url('${base}img/aterpea/slide-02.jpg')`}></div>
          <div class="carousel__slide" style={`background-image:url('${base}img/aterpea/slide-03.jpg')`}></div>
          <div class="carousel__slide" style={`background-image:url('${base}img/aterpea/slide-04.jpg')`}></div>
          <div class="carousel__slide" style={`background-image:url('${base}img/aterpea/slide-05.jpg')`}></div>
          <div class="carousel__slide" style={`background-image:url('${base}img/aterpea/slide-06.jpg')`}></div>
          <div class="carousel__slide" style={`background-image:url('${base}img/aterpea/slide-07.jpg')`}></div>
          <div class="carousel__slide" style={`background-image:url('${base}img/aterpea/slide-08.jpg')`}></div>
        </div>
        <button class="carousel__nav prev" type="button" aria-label="Aurrekoa">&#8249;</button>
        <button class="carousel__nav next" type="button" aria-label="Hurrengoa">&#8250;</button>
        <div class="carousel__dots"><span class="on"></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
      </div>
      <div class="reveal">
        <div class="zonak">
          <div class="zona"><img class="zona-img" src={`${base}img/aterpea/handia.jpg`} alt="Aterpe handia" loading="lazy"><h4>Aterpe handia</h4><div class="plaza">24 plaza</div></div>
          <div class="zona"><img class="zona-img" src={`${base}img/aterpea/txikia.jpg`} alt="Aterpe txikia" loading="lazy"><h4>Aterpe txikia</h4><div class="plaza">12 plaza</div></div>
        </div>
        <div class="note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg><span><b>Erreserbak aurrez aurre soilik.</b> Aterpea erreserbatzeko, klubaren egoitzara etorri behar da. Web bidez ezin da erreserbatu.</span></div>
        <div class="aterpe-bars">
        <button class="historia__btn aterpe-bar" id="aterpeHistoriaBtn" aria-haspopup="dialog">
          <span><span class="historia__k">Ezagutu gure jatorria</span>Aterpearen historia</span>
          <svg class="chev chev--right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <button class="historia__btn aterpe-bar" id="aterpeTarifakBtn" aria-haspopup="dialog">
          <span><span class="historia__k">Prezioak</span>Tarifak</span>
          <svg class="chev chev--right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <button class="historia__btn aterpe-bar" id="aterpeArauakBtn" aria-haspopup="dialog">
          <span><span class="historia__k">Erabilera-arauak</span>Arauak</span>
