    <div id="fichaForm">
      <h3 id="fichaTitle">Izena eman</h3>
      <p class="sub" id="fichaSub">Bete fitxa. Zure datuak klubak soilik kudeatuko ditu.</p>
      <div class="grid2">
        <div class="field"><label>Izena</label><input id="f-izena" type="text"></div>
        <div class="field"><label>Abizenak</label><input id="f-abizenak" type="text"></div>
      </div>
      <div class="grid2">
        <div class="field"><label>NAN / DNI</label><input id="f-nan" type="text"></div>
        <div class="field"><label>Jaiotze-data</label><input id="f-jaiotza" type="date"></div>
      </div>
      <div class="grid2">
        <div class="field"><label>Telefonoa</label><input id="f-tel" type="tel"></div>
        <div class="field"><label>E-posta</label><input id="f-eposta" type="email"></div>
      </div>
      <div class="field"><label>Bazkidea zara?</label>
        <select id="f-bazkide"><option value="bai">Bai, bazkidea naiz</option><option value="ez">Ez naiz bazkidea</option></select>
      </div>
      <div class="field" id="f-bazkidezbk-wrap"><label>Bazkide zenbakia</label><input id="f-bazkidezbk" type="text" placeholder="Bazkidea bazara"></div>
      <div class="field"><label>Oharrak</label><textarea id="f-oharrak" rows="2"></textarea></div>
      <button class="btn btn--primary" id="fichaSubmit">Bidali izen-ematea</button>
    </div>
    <div class="modal__ok" id="fichaOk" style="display:none">
      <div class="tick">✓</div><h3>Izena emanda!</h3>
      <p class="sub">Zure izen-ematea jaso dugu. Eskerrik asko.</p>
      <button class="btn btn--dark" data-close>Itxi</button>
    </div>
  </div>
</div>

<div class="modal" id="calc">
  <div class="modal__box">
    <button class="modal__close" data-close aria-label="Itxi">&times;</button>
    <div id="calcForm">
      <h3>Federazio-simulagailua</h3>
      <p class="sub">Aukeratu zure lizentzia eta ikusi zer estaltzen duen.</p>
      <div class="calc-sec">1 · Lizentzia mota</div>
      <div id="calcMod"></div>
      <div class="calc-sec">2 · Estaldura-eremua</div>
      <div id="calcScope"></div>
      <div class="calc-sec">3 · Gehigarriak (aukerakoak)</div>
      <div id="calcAddons"></div>
      <div class="calc-sec">4 · Zure datuak</div>
      <input id="c-izena" class="calc-in" type="text" placeholder="Izena eta abizenak *" required style="margin-bottom:.5rem">
      <input id="c-nan" class="calc-in" type="text" placeholder="NAN / NIF" style="margin-bottom:.5rem">
      <input id="c-bazkide" class="calc-in" type="text" placeholder="Bazkide zenbakia (aukerakoa)">
      <div class="total-bar"><span>Guztira (gutxi gorabehera)</span><b id="calcTotal">0,00 €</b></div>
      <button class="btn btn--primary" id="calcPdf">Dokumentua sortu (PDF)</button>
      <div class="note calc-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg><span><b>Federatzea klubaren egoitzan soilik egin daiteke.</b> Gomendagarria da sortutako PDF dokumentua zurekin eramatea, izapidea azkarragoa izan dadin.</span></div>
    </div>
  </div>
</div>

